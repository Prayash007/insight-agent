# InsightAgent Environment Configuration

# Database Configuration (Postgres 16 for production / Railway / Supabase, or SQLite for local zero-config dev)
# Local SQLite default:
DATABASE_URL=sqlite:///database/insight_brokerage.db
# PostgreSQL Example:
# DATABASE_URL=postgresql+psycopg://angel_analyst:angel_secure_password@localhost:5432/insight_brokerage

# MCP Server
MCP_SERVER_URL=http://localhost:8001/sse
MCP_USE_IN_PROCESS=true
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001

# LLM Providers (Multi-provider support: Google Gemini, OpenAI, Groq, or Mock offline)
LLM_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gemini-2.5-flash

# Query Guardrails & Retries
MAX_SQL_RETRIES=2
MAX_ROWS_RETURNED=500
